{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "basis",
  // worker/index.ts wraps the generated .open-next/worker.js to add the
  // scheduled handler (the cron). See that file.
  "main": "worker/index.ts",
  // OpenNext needs nodejs_compat and a compatibility date at or after
  // 2024-09-23 (decisions/2026-09-16-cloudflare-not-vercel.md).
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Both namespaces were created in the dashboard on 2026-09-16
  // (decisions/2026-09-16-deploy-through-git-integration.md): no wrangler
  // login on this machine. `wrangler dev` simulates both locally.
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "c58750ed89574e19a8e95c4c2e25d9a1" },
    { "binding": "BASIS_KV", "id": "ba3e7f2f671748069c9b3a5bbd268e0f" }
  ],
  // The agent: hourly. The fastest source is minutes and docs/spec.md caps
  // the cadence at 15, but 96 runs a day is the multiplier on every KV write
  // the handler makes and the free tier allows 1,000 a day
  // (decisions/2026-09-18-the-write-budget.md). The data is simulated; its
  // freshness is not what Basis demonstrates.
  "triggers": { "crons": ["0 * * * *"] },
  // Fixture mode for the e2e suite and offline work: `opennextjs-cloudflare
  // preview -e fixtures`. Wrangler environments do not inherit bindings or
  // vars, so the two namespaces and the assets block are restated. Nothing
  // sets BASIS_FIXTURES on the production environment.
  "env": {
    "fixtures": {
      "vars": { "BASIS_FIXTURES": "1" },
      "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
      "kv_namespaces": [
        { "binding": "NEXT_INC_CACHE_KV", "id": "c58750ed89574e19a8e95c4c2e25d9a1" },
        { "binding": "BASIS_KV", "id": "ba3e7f2f671748069c9b3a5bbd268e0f" }
      ]
    }
  }
}
