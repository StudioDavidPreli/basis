{
  "name": "basis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A sourced-data surface built on the Cadence motion system. Simulated companies, real public drivers, provenance on every figure, a scheduled refresh that behaves like an agent without being one.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "predev": "node scripts/rive-wasm.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/rive-wasm.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && eslint -c eslint/css.config.mjs \"**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "preview:fixtures": "opennextjs-cloudflare build && opennextjs-cloudflare preview -e fixtures",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test:e2e:dev": "playwright test -c playwright.dev.config.ts",
    "test:live": "vitest run -c vitest.live.config.ts"
  },
  "dependencies": {
    "@rive-app/react-canvas": "^4.36.0",
    "cadence-tokens": "^2.0.1",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "framer-motion": "^12",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4",
    "@eslint/css": "^0.13",
    "@opennextjs/cloudflare": "^1.20",
    "@playwright/test": "^1.5",
    "@testing-library/react": "^16",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^26",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^3",
    "wrangler": "^4"
  }
}
